<% v1 = Dradis::Plugins::Calculators::AIVSSSSVC::V1 %>

<section class="aivss-ssvc-group">
  <h3 class="aivss-ssvc-section-title">Inputs</h3>
  <p class="aivss-ssvc-section-hint">
    Set the threat, vulnerability, and impact. Then score all ten capability factors. The calculator uses these values to set the agent level, risk score, and SSVC outcome.
  </p>

  <% v1::INPUTS.each do |input| %>
    <div class="aivss-ssvc-field">
      <span id="aivss-ssvc-<%= input[:id] %>-label" class="aivss-ssvc-label"><%= input[:label] %></span>
      <%= hidden_field_tag input[:id], @aivss_ssvc_selection[input[:id]],
            id: "aivss-ssvc-#{input[:id]}",
            data: {
              behavior: 'aivss-ssvc-input',
              field: input[:field],
              input: input[:id],
              value_field: input[:value_field]
            } %>
      <div class="aivss-ssvc-btn-group btn-group" role="group" aria-labelledby="aivss-ssvc-<%= input[:id] %>-label">
        <% input[:options].each do |option| %>
          <button
            type="button"
            class="btn <%= 'active btn-primary' if @aivss_ssvc_selection[input[:id]] == option[:key] %>"
            title="<%= option[:description] %>"
            aria-pressed="<%= @aivss_ssvc_selection[input[:id]] == option[:key] %>"
            value="<%= option[:key] %>"
            data-behavior="aivss-ssvc-choice"
            data-select-target="aivss-ssvc-<%= input[:id] %>"
            data-score="<%= option[:value] %>"
            data-label="<%= option[:label] %>"><%= "#{option[:label]} (#{option[:value]})" %></button>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
