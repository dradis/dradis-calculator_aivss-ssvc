<% v1 = Dradis::Plugins::Calculators::AivssSsvc::V1 %>

<section class="aivss-ssvc-group">
  <h3 class="aivss-ssvc-section-title">Inputs</h3>
  <p class="aivss-ssvc-hint">Set exploitation state, vulnerability posture, and systemic impact, then score the ten capability factors. The calculator computes category averages, classifies the agent level, calculates the numeric score, and maps the qualitative triple to the SSVC outcome.</p>

  <% v1::INPUTS.each do |input| %>
    <div class="aivss-ssvc-field">
      <label class="form-label aivss-ssvc-label" for="aivss-ssvc-<%= input[:id] %>"><%= input[:label] %></label>
      <p class="aivss-ssvc-help"><%= input[:help] %></p>
      <select
        id="aivss-ssvc-<%= input[:id] %>"
        class="form-select"
        data-behavior="aivss-ssvc-input"
        data-input="<%= input[:id] %>"
        data-field="<%= input[:field] %>"
        data-value-field="<%= input[:value_field] %>"
        data-combobox-config="no-combobox">
        <% input[:options].each do |option| %>
          <option
            value="<%= option[:key] %>"
            data-score="<%= option[:value] %>"
            data-label="<%= option[:label] %>"
            <%= 'selected' if @aivss_ssvc_selection[input[:id]] == option[:key] %>><%= "#{option[:label]} (#{option[:value]})" %></option>
        <% end %>
      </select>
    </div>
  <% end %>
</section>
