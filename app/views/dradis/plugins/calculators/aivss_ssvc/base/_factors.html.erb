<% v1 = Dradis::Plugins::Calculators::AivssSsvc::V1 %>

<section class="aivss-ssvc-group">
  <h3 class="aivss-ssvc-section-title">Exposure: 10 Capability Factors (1–5)</h3>
  <p class="aivss-ssvc-hint">Category A averages factors 1–4, Category B averages factors 5–7, and Category C averages factors 8–10. Mixed-score rules classify Copilot (2&times;), Specialist (4&times;), or Prime Mover (8&times;).</p>

  <table class="table table-striped aivss-ssvc-factors">
    <thead>
      <tr>
        <th style="width: 56%;">Factor</th>
        <th style="width: 24%;">Category</th>
        <th style="width: 20%;">Score</th>
      </tr>
    </thead>
    <tbody>
      <% v1::FACTORS.each do |factor| %>
        <tr>
          <td>
            <label class="aivss-ssvc-factor-name" for="aivss-ssvc-<%= factor[:id] %>"><%= factor[:name] %></label>
            <span class="aivss-ssvc-factor-desc"><%= factor[:description] %></span>
          </td>
          <td class="aivss-ssvc-factor-category"><%= v1::CATEGORIES[factor[:category]] %></td>
          <td>
            <select
              id="aivss-ssvc-<%= factor[:id] %>"
              class="form-select"
              data-behavior="aivss-ssvc-factor"
              data-category="<%= factor[:category] %>"
              data-field="AIVSS-SSVC.<%= factor[:field] %>"
              data-combobox-config="no-combobox">
              <% (1..5).each do |score| %>
                <option value="<%= score %>" <%= 'selected' if @aivss_ssvc_selection['factors'][factor[:id]] == score %>><%= score %></option>
              <% end %>
            </select>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
